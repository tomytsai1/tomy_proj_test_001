num = int(input())
out = num
row = input().split()
row = [int(x) for x in row]
i = 0
j = 2

while True:
    # print(row[i:j])
    # print(i, j, end=" ")
    
    if (sum(row[i:j]) / (j - i)) % 1 == 0:
        # print("added")
        out += 1
        
    if j < num:
        j += 1
        
    else:
        i += 1
        j = i + 2
        
    if i == num - 1 or j > num:
        break

# print(row)
# print(max(row))
print(out)
